# Copy to backend/data/local.env (ignored by Git). Process environment wins.
AINET_BIND_HOST=127.0.0.1
AINET_BIND_PORT=8000
ENSP_HOST=127.0.0.1
# Configure your own environment in the course page or here.
# AINET_LAB_PROVIDER=enspro
# AINET_ENSPRO_URL=https://ensp-pro.example:8443
# AINET_ENSPRO_START_TIMEOUT=300
# AINET_ENSPRO_MAX_DEVICES=3
# Optional, for one person using this computer:
# AINET_AUTO_LOGIN=admin
# LAN access: set AINET_BIND_HOST to an appropriate local interface address.
# LAN auto-login additionally requires AINET_ALLOW_LAN_AUTO_LOGIN=1.
